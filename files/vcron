proc Enlever {} {
    global Messages

    set ind [.fram1.frm10.lst1 curselection]
    if { $ind != "" } {
	set line [.fram1.frm10.lst1 get $ind]
	set typ [tk_dialog .type $Messages(deltitle) \
		"$Messages(confdel)\n$line" question -1 \
		$Messages(msgok) $Messages(cancel) ]

