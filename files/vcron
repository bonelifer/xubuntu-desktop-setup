	}
    }
}

proc CheckTab {tabname indx} {
    upvar $tabname mytab

    set val $mytab($indx)
    if { $indx == "*" } {
	if { $val == 1 } {
	    # setting * remove all others
	    foreach loopi [array names mytab] {
		if { $loopi != "*" } {
		    set mytab($loopi) 0
		}
	    }
	}
    } else {
	if { $mytab(*) == 1 } {
	    # more than one value is forbidden if * is set
	    foreach loopi [array names mytab] {
		if { $loopi != "*" && $loopi != $indx } {
		    set mytab($loopi) 0
		}
	    }
	    # and 0 or 1 is not a correct cycle value !
	    set mytab(0) 0
	    set mytab(1) 0
	}
    }

}

