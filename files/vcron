proc Modifier {} {
    global st_cremod st_cronat

# for cron job you can modify
# for at job you can just view

    set ind [.fram1.frm10.lst1 curselection]
    if { $ind != "" } {
	InitTabVar [.fram1.frm10.lst1 get $ind]
	set st_cremod $ind
	set st_cronat "cron"
