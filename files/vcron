	    RePostCronTab
	}
    } else {
	set ind [.fram2.frm20.lst2 curselection]
	if { $ind != "" } {
	    set line [.fram2.frm20.lst2 get $ind]
	    set typ [tk_dialog .type $Messages(deltitle) \
